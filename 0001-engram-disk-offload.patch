+def _safetensors_tensor_span(path: str) -> tuple[int, dict]:
+    """The data-section offset and tensor header of a safetensors file."""
+    with open(path, "rb") as file:
+        (header_len,) = struct.unpack("<Q", file.read(8))
+        header = json.loads(file.read(header_len))
+    return 8 + header_len, header
+
+
+def _resolve_checkpoint_tensor(model_path: str, name: str) -> str:
+    """The safetensors shard that holds `name`, from the index or a single file."""
+    if not os.path.isdir(model_path):
+        raise ValueError(
+            "Engram disk_offload needs a local checkpoint directory, got "
+            f"{model_path!r}"
+        )
+    index = os.path.join(model_path, "model.safetensors.index.json")
+    if os.path.isfile(index):
+        with open(index) as file:
+            weight_map = json.load(file)["weight_map"]
+        if name not in weight_map:
+            raise KeyError(f"{name} is not in {index}")
+        return os.path.join(model_path, weight_map[name])
+    single = os.path.join(model_path, "model.safetensors")
+    if os.path.isfile(single):
+        return single
+    raise FileNotFoundError(f"no safetensors index or file in {model_path}")
