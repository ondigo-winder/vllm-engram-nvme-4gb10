+        self.scales_np = self._map_rows(model_path, scale_name, self.scale_dim)
+        self._pool = ThreadPoolExecutor(threads, thread_name_prefix="engram-disk")
+        self._capacity = 0
+        self._weight_buf: torch.Tensor | None = None
+        self._scales_buf: torch.Tensor | None = None
+        self._copy_done: torch.cuda.Event | None = None
+        self._timing: dict[str, tuple[int, float, int, float, float]] = {}
+        self._timing_calls = 0
+        self._ids_buf: torch.Tensor | None = None
