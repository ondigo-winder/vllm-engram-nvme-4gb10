+        try:
+            os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_RANDOM)
+            mapping = mmap.mmap(
+                fd,
+                offset - page_offset + length,
+                flags=mmap.MAP_PRIVATE,
+                prot=mmap.PROT_READ | mmap.PROT_WRITE,
+                offset=page_offset,
+            )
+        finally:
+            os.close(fd)
+        mapping.madvise(mmap.MADV_RANDOM)
