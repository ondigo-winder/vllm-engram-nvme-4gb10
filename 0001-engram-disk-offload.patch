+    def _map_rows(self, model_path: str, name: str, width: int) -> np.ndarray:
+        path = _resolve_checkpoint_tensor(model_path, name)
+        data_start, header = _safetensors_tensor_span(path)
+        info = header[name]
+        itemsize = _SAFETENSORS_ITEMSIZE[info["dtype"]]
+        shape = info["shape"]
+        row_bytes = int(np.prod(shape[1:])) * itemsize
+        if row_bytes != width:
+            raise ValueError(
+                f"{name}: checkpoint rows are {row_bytes} B, expected {width} B"
+            )
+        if self.vocab_start + self.num_rows > shape[0]:
+            raise ValueError(
+                f"{name}: shard [{self.vocab_start}, "
+                f"{self.vocab_start + self.num_rows}) exceeds {shape[0]} rows"
+            )
+        start, end = info["data_offsets"]
+        offset = data_start + start + self.vocab_start * width
+        length = self.num_rows * width
+        assert offset + length <= data_start + end
