+def _resolve_checkpoint_tensor(model_path: str, name: str) -> str:
+    """The safetensors shard that holds `name`, from the index or a single file."""
+    if not os.path.isdir(model_path):
+        raise ValueError(
+            "Engram disk_offload needs a local checkpoint directory, got "
+            f"{model_path!r}"
